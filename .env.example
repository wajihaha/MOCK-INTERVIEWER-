# VITE_GROQ_API_KEY: Optional build/environment Groq API key (gsk_...)
# Users can also paste and save their own free Groq API key directly in the in-app API Key Settings modal.
VITE_GROQ_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
